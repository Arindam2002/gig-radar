# Copy to .env and fill in what you have. Everything is optional —
# the pipeline runs without any keys, features just degrade gracefully.

# Gemini (free key at https://aistudio.google.com)
# Unlocks: structured JD extraction (experience/salary/seniority/eligibility),
# LLM-personalized outreach drafts, company-tier classification.
GEMINI_API_KEY=

# Firecrawl (https://firecrawl.dev)
# Unlocks: the Naukri source (JS-rendered scraping), HR-contact web search,
# careers-page scraping, prospect discovery.
FIRECRAWL_API_KEY=

# Hunter (free tier at https://hunter.io, 25 lookups/mo)
# Unlocks: company email-pattern lookup in the Outreach page.
HUNTER_API_KEY=

# Extra job sources (both optional)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_RAPIDAPI_KEY=
